{
  "$schema": "https://opencode.ai/config.json",
  "model": "copilot/claude-sonnet-4-5",
  "theme": "tokyonight-moon-transparent",
  "autoupdate": true,
  "keybinds": {
    "command_list": "alt+?"
  },
  "permission": {
    "edit": "ask"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    },
    "diff_style": "auto"
  }
}
