default_layout "compact"
default_shell "/bin/zsh"
mouse_mode true
copy_command "pbcopy"     
copy_on_select true
on_force_close "quit"
session_serialization false // Don't preserve sessions for resurrection — prevents orphaned nvim/LSP processes
show_startup_tips false
show_release_notes false
advanced_mouse_actions false

plugins {
    autolock location="https://github.com/fresh2dev/zellij-autolock/releases/latest/download/zellij-autolock.wasm" {
        triggers "nvim|vim"
        watch_triggers "fzf|zoxide|atuin"
        watch_interval "1.0"
    }
}

keybinds {
    // Normal mode bindings to forward Enter and notify autolock.
    normal {
        bind "Enter" {
            WriteChars "\u{000D}";
            MessagePlugin "autolock" {};
        }
        bind "Ctrl g" { SwitchToMode "Locked"; }
        bind "Ctrl p" { SwitchToMode "Pane"; }
        bind "Ctrl q" { Detach; }
        bind "Alt q"  { Quit; }
        
        // Pane management (use Ctrl-p to enter pane mode)
        bind "Alt x"  { CloseFocus; }
        bind "Alt f"  { ToggleFocusFullscreen; }
        bind "Alt z"  { TogglePaneFrames; }
        
        // Pane navigation
        bind "Alt h" "Alt Left"  { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down"  { MoveFocus "Down"; }
        bind "Alt k" "Alt Up"    { MoveFocus "Up"; }
        
        // Tab management
        bind "Alt t"  { NewTab; }
        bind "Alt w"  { CloseTab; }
        bind "Alt 1"  { GoToTab 1; }
        bind "Alt 2"  { GoToTab 2; }
        bind "Alt 3"  { GoToTab 3; }
        bind "Alt 4"  { GoToTab 4; }
        bind "Alt 5"  { GoToTab 5; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Ctrl s" { SwitchToMode "Scroll"; }
    }
    
    // Locked mode - these keybindings work even when locked (i.e., when nvim is running)
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
        bind "Ctrl p" { SwitchToMode "Pane"; }
        bind "Ctrl n" { SwitchToMode "Resize"; }
        
        // Pane management (use Ctrl-p to enter pane mode)
        // Note: Alt-x intentionally NOT bound here — nvim uses it for
        // Helix-style shrink-to-line-bounds. Use Ctrl-p then x to close pane.
        bind "Alt f"  { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "Alt z"  { TogglePaneFrames; SwitchToMode "Locked"; }

        // Tab management
        bind "Alt t"  { NewTab; SwitchToMode "Locked"; }
        bind "Alt w"  { CloseTab; SwitchToMode "Locked"; }
        bind "Alt 1"  { GoToTab 1; SwitchToMode "Locked"; }
        bind "Alt 2"  { GoToTab 2; SwitchToMode "Locked"; }
        bind "Alt 3"  { GoToTab 3; SwitchToMode "Locked"; }
        bind "Alt 4"  { GoToTab 4; SwitchToMode "Locked"; }
        bind "Alt 5"  { GoToTab 5; SwitchToMode "Locked"; }
        bind "Alt [" { GoToPreviousTab; SwitchToMode "Locked"; }
        bind "Alt ]" { GoToNextTab; SwitchToMode "Locked"; }
        bind "Ctrl s" { SwitchToMode "Scroll"; }
        
        // Session management
        bind "Ctrl q" { Detach; }
        bind "Alt q"  { Quit; }
    }
    
    // Pane mode - for pane management operations
    pane {
        bind "Ctrl p" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }
        
        bind "h" "Left" { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
    }
    
    // Scroll mode - scroll through pane history
    scroll {
        bind "Ctrl s" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }
    
    // Search mode - search within scroll history
    search {
        bind "Ctrl s" { SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    
    // Enter search mode - type search query then press Enter
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
}

themes {
    cyberdream {
        text_unselected {
            base 255 255 255
            background 0
            emphasis_0 255 189 94
            emphasis_1 94 241 255
            emphasis_2 94 161 255
            emphasis_3 189 94 255
        }
        text_selected {
            base 255 255 255
            background 60 64 72
            emphasis_0 255 189 94
            emphasis_1 94 241 255
            emphasis_2 94 161 255
            emphasis_3 189 94 255
        }
        ribbon_selected {
            base 60 64 72
            background 94 161 255
            emphasis_0 255 110 94
            emphasis_1 255 189 94
            emphasis_2 189 94 255
            emphasis_3 94 161 255
        }
        ribbon_unselected {
            base 60 64 72
            background 123 132 150
            emphasis_0 255 110 94
            emphasis_1 255 255 255
            emphasis_2 94 161 255
            emphasis_3 189 94 255
        }
        table_title {
            base 94 161 255
            background 0
            emphasis_0 255 189 94
            emphasis_1 94 241 255
            emphasis_2 94 161 255
            emphasis_3 189 94 255
        }
        table_cell_selected {
            base 255 255 255
            background 30 33 36
            emphasis_0 255 189 94
            emphasis_1 94 241 255
            emphasis_2 94 161 255
            emphasis_3 189 94 255
        }
        table_cell_unselected {
            base 255 255 255
            background 60 64 72
            emphasis_0 255 189 94
            emphasis_1 94 241 255
            emphasis_2 94 161 255
            emphasis_3 189 94 255
        }
        list_selected {
            base 255 255 255
            background 30 33 36
            emphasis_0 255 189 94
            emphasis_1 94 241 255
            emphasis_2 94 161 255
            emphasis_3 189 94 255
        }
        list_unselected {
            base 255 255 255
            background 60 64 72
            emphasis_0 255 189 94
            emphasis_1 94 241 255
            emphasis_2 94 161 255
            emphasis_3 189 94 255
        }
        frame_selected {
            base 94 161 255
            background 0
            emphasis_0 255 189 94
            emphasis_1 94 241 255
            emphasis_2 189 94 255
            emphasis_3 0
        }
        frame_highlight {
            base 255 189 94
            background 0
            emphasis_0 189 94 255
            emphasis_1 255 189 94
            emphasis_2 255 189 94
            emphasis_3 255 189 94
        }
        exit_code_success {
            base 94 161 255
            background 0
            emphasis_0 94 241 255
            emphasis_1 60 64 72
            emphasis_2 189 94 255
            emphasis_3 94 161 255
        }
        exit_code_error {
            base 255 110 94
            background 0
            emphasis_0 241 255 94
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 189 94 255
            player_2 94 161 255
            player_3 0
            player_4 255 189 94
            player_5 94 241 255
            player_6 0
            player_7 255 110 94
            player_8 0
            player_9 0
            player_10 0
        }
    }
}

theme "cyberdream"

ui {
    pane_frames {
        hide_session_name true
    }
}